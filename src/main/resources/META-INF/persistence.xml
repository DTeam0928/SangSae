<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

  <persistence-unit name="default" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    
    <!-- Quest Entity -->
	<class>com.dteam0928.sangsae.quest.dto.QuestTemplate</class>
	<class>com.dteam0928.sangsae.quest.dto.UserQuest</class>
	<class>com.dteam0928.sangsae.quest.dto.QuestLog</class>
	<class>com.dteam0928.sangsae.quest.dto.UserQuestBookmark</class>

    <!-- Routine Entity -->
    <class>com.dteam0928.sangsae.routine.entity.RoutineTemplate</class>
    <class>com.dteam0928.sangsae.routine.entity.RoutineTemplateTask</class>
    <class>com.dteam0928.sangsae.routine.entity.UserRoutine</class>
    <class>com.dteam0928.sangsae.routine.entity.UserRoutineTask</class>
    <class>com.dteam0928.sangsae.routine.entity.RoutineTaskSchedule</class>
    <class>com.dteam0928.sangsae.routine.entity.RoutineTaskLog</class>
    
    <!-- 엔티티 목록: 엔티티(@Entity)를 새로 만들면 여기에 한 줄 추가 -->
    <class>com.dteam0928.sangsae.user.model.User</class>
    <class>com.dteam0928.sangsae.user.model.UserProfile</class>
    <class>com.dteam0928.sangsae.user.model.InterestCategory</class>
    <class>com.dteam0928.sangsae.user.model.UserInterest</class>
    
    <exclude-unlisted-classes>false</exclude-unlisted-classes>
    
    <properties>
      <!-- DB 접속 정보는 여기 적지 않는다: AppContext 가 application(-local).properties 로 만든 커넥션 풀을 넘겨준다 -->
      <!-- 테이블은 sql/ 스크립트로 만든다. POINT 컬럼 등 JPA 가 모르는 컬럼이 있어 자동 생성(create/update)은 쓰지 않음 -->
      <property name="hibernate.hbm2ddl.auto" value="none"/>
      <property name="hibernate.show_sql" value="false"/>
      <property name="hibernate.format_sql" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
